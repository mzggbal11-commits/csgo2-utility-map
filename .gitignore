* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  color: #e2e8f0;
  background: #0f172a;
  line-height: 1.5;
  font-weight: 400;
  color-scheme: dark;
}

html,
body,
#root {
  min-height: 100%;
  height: 100%;
  margin: 0;
}

body {
  background:
    radial-gradient(circle at top, rgba(59, 130, 246, 0.2), transparent 30%),
    linear-gradient(180deg, #020817 0%, #0f172a 100%);
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  max-width: 1600px;
  margin: 0 auto;
  padding: 32px 24px 48px;
}

.topbar,
.toolbar,
.panel-header,
.card-head,
.detail-meta,
.type-filter,
.map-item,
.point-card,
.throw-box,
.instruction-box,
.note-box {
  display: flex;
}

.topbar {
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.eyebrow {
  margin: 0 0 8px;
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #7dd3fc;
}

h1,
h2,
h3,
h4,
p {
  margin: 0;
}

h1 {
  font-size: clamp(2rem, 3vw, 3rem);
  letter-spacing: -0.06em;
}

.badge,
.tag,
.point-count {
  border-radius: 999px;
  background: rgba(14, 165, 233, 0.12);
  color: #bae6fd;
  border: 1px solid rgba(125, 211, 252, 0.25);
}

.badge {
  padding: 10px 14px;
  font-size: 0.8rem;
}

.toolbar {
  flex-direction: column;
  gap: 16px;
  margin-bottom: 24px;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 12px;
  padding: 14px 16px;
}

.search-box input {
  flex: 1;
  background: transparent;
  color: white;
  border: none;
  outline: none;
  font-size: 1rem;
}

.type-filter {
  flex-wrap: wrap;
  gap: 10px;
}

.type-filter button,
.map-item {
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(15, 23, 42, 0.8);
  color: #dfe7f0;
  border-radius: 10px;
  padding: 10px 14px;
  transition: 0.2s ease;
}

.type-filter button.active,
.map-item.active {
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  border-color: transparent;
  color: white;
}

.content-grid {
  display: grid;
  grid-template-columns: 320px minmax(0, 1fr) 370px;
  gap: 20px;
}

.map-panel,
.results-panel,
.detail-panel {
  background: rgba(15, 23, 42, 0.72);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 18px;
  padding: 20px;
  backdrop-filter: blur(10px);
}

.map-panel,
.results-panel,
.detail-panel {
  min-height: 720px;
}

.map-panel h2,
.panel-header h2,
.detail-header h3 {
  margin-bottom: 16px;
}

.map-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.map-item {
  justify-content: space-between;
  align-items: center;
  width: 100%;
  text-align: left;
  padding: 14px 16px;
}

.map-item strong,
.point-card h3 {
  display: block;
  margin-bottom: 4px;
}

.map-item small,
.area-line {
  color: #bfd2e8;
  font-size: 0.8rem;
}

.panel-header {
  align-items: end;
  justify-content: space-between;
  margin-bottom: 16px;
}

.point-count {
  padding: 8px 12px;
  font-size: 0.8rem;
}

.point-list {
  display: grid;
  gap: 12px;
}

.point-card {
  flex-direction: column;
  gap: 10px;
  padding: 16px;
  border-radius: 14px;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.14);
  transition: 0.2s ease;
}

.point-card.active {
  border-color: rgba(56, 189, 248, 0.7);
  box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.3);
}

.card-head {
  gap: 8px;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 5px 8px;
  font-size: 0.75rem;
}

.mini-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.mini-tags span {
  background: rgba(30, 41, 59, 0.9);
  color: #dbeafe;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 999px;
  padding: 5px 8px;
  font-size: 0.75rem;
}

.description {
  color: #c5d1e2;
}

.detail-panel {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.detail-meta {
  flex-wrap: wrap;
  gap: 8px;
}

.detail-meta span {
  padding: 6px 10px;
  background: rgba(30, 41, 59, 0.9);
  border-radius: 999px;
  border: 1px solid rgba(148, 163, 184, 0.15);
  font-size: 0.75rem;
}

.throw-box,
.instruction-box,
.note-box {
  flex-direction: column;
  gap: 12px;
  background: rgba(2, 6, 23, 0.42);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 14px;
  padding: 16px;
}

.throw-box p,
.note-box p {
  color: #dbeafe;
}

.instruction-box ol {
  margin: 0;
  padding-left: 18px;
  color: #dbeafe;
}

.instruction-box li + li {
  margin-top: 8px;
}

@media (max-width: 1100px) {
  .content-grid {
    grid-template-columns: 1fr;
  }

  .map-panel,
  .results-panel,
  .detail-panel {
    min-height: auto;
  }
}
